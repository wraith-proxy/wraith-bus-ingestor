# Copy to .env and fill in. Real values never leave this machine.

# Secrets
BODS_API_KEY=your-bods-api-key

# Container names
TILES_CONTAINER=tiles
QUESTDB_CONTAINER=db
API_CONTAINER=api
INGESTOR_CONTAINER=ingestor
OSRM_CONTAINER=osrm
ARCHIVER_CONTAINER=archiver
GRAFANA_CONTAINER=grafana
NTFY_CONTAINER=ntfy

# Host-exposed ports (only db and tiles publish one -- api/osrm/archiver/
# ingestor are reachable only from inside ghost-net)
TILES_PORT=3001
QUESTDB_HTTP_PORT=9001
QUESTDB_PG_PORT=8812

# Internal upstream, container-name:port on ghost-net
QUESTDB_URL=http://db:9000
# Self-hosted routing engine, used to snap route lines to real roads.
# No host port -- only the api container talks to it.
OSRM_URL=http://osrm:5000

# A separate disk/mount for cold storage of old bus_positions partitions.
# Must be a real, separate mount point -- archive.py checks for a
# .this-is-vault2 sentinel file inside it before touching anything, and
# skips the run rather than silently archiving onto the main disk if the
# drive isn't actually mounted there.
# 7 days live + 1 day buffer. Keep in sync with dbt's own `extract_days` var
# (dbt/dbt_project.yml) -- that's the window dbt keeps in its incremental
# tables, so it should match what's actually still hot in QuestDB.
ARCHIVE_PATH=/mnt/change-me/wraith-bus-ingestor-archive
RETENTION_DAYS=8

# This repo's own live data volumes (migrated in from ghost-site 2026-09-14 --
# see docs/architecture.md). Absolute paths to THIS checkout's directory.
# Two things to get right:
#   - no trailing slash: the archiver mount is built as ${QUESTDB_DATA_PATH}/db
#   - absolute, or at minimum "./"-prefixed: a bare name like "questdb_data"
#     is read by Compose as a NAMED VOLUME, which would start QuestDB against
#     an empty volume while the real data sits untouched on disk
QUESTDB_DATA_PATH=/change-me/wraith-bus-ingestor/questdb_data
MAPS_PATH=/change-me/wraith-bus-ingestor/maps
OSRM_DATA_PATH=/change-me/wraith-bus-ingestor/osrm_data

# Grafana dashboards and ntfy alert delivery.
# Grafana's own data volume, in THIS checkout, and the same two rules the
# paths above carry:
#   - no trailing slash
#   - absolute, or at minimum "./"-prefixed: a bare name like "grafana_data" is
#     read by Compose as a NAMED VOLUME, so Grafana would come up empty every
#     time while the real dashboards sit untouched on disk
# One extra: Grafana writes this as its in-container uid 472, so chown it to
# 472 once before the first `up` or the container exits on a permission error.
GRAFANA_DATA_PATH=/change-me/wraith-bus-ingestor/grafana_data

# Only gates edit/admin. Anonymous visitors are already given the Viewer role
# on purpose, so nobody needs this password to read a dashboard.
GRAFANA_ADMIN_PASSWORD=change-me

# Must match the nginx location Grafana is proxied under, and must keep its
# trailing slash -- Grafana builds every asset URL by appending to this string,
# so dropping the slash serves dashboards with broken CSS and JS.
GRAFANA_ROOT_URL=https://change-me/grafana/

# The topic name IS the credential: ntfy has no other auth here, so anyone who
# learns it can subscribe to every alert this box sends. Generate it random
# (`openssl rand -hex 16`), never commit it, and never let it reach a log line
# or an HTTP response body.
NTFY_TOPIC=change-me-random-hex
