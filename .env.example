# Copy to .env and fill in. Real values never leave this machine.

# Secrets
BODS_API_KEY=your-bods-api-key

# Container names
TILES_CONTAINER=tiles
QUESTDB_CONTAINER=db
API_CONTAINER=api
INGESTOR_CONTAINER=ingestor
OSRM_CONTAINER=osrm
ARCHIVER_CONTAINER=archiver

# Host-exposed ports (only db and tiles publish one -- api/osrm/archiver/
# ingestor are reachable only from inside ghost-net)
TILES_PORT=3001
QUESTDB_HTTP_PORT=9001
QUESTDB_PG_PORT=8812

# Internal upstream, container-name:port on ghost-net
QUESTDB_URL=http://db:9000
# Self-hosted routing engine, used to snap route lines to real roads.
# No host port -- only the api container talks to it.
OSRM_URL=http://osrm:5000

# A separate disk/mount for cold storage of old bus_positions partitions.
# Must be a real, separate mount point -- archive.py checks for a
# .this-is-vault2 sentinel file inside it before touching anything, and
# skips the run rather than silently archiving onto the main disk if the
# drive isn't actually mounted there.
ARCHIVE_PATH=/mnt/change-me/ghost-bus-archive
RETENTION_DAYS=22

# Shared, live data volumes NOT physically moved into this repo when it was
# split out of ghost-site (see docs/architecture.md for why) -- point these
# at wherever ghost-site's own questdb_data/, maps/ and osrm_data/ actually
# live on this host until that migration happens.
QUESTDB_DATA_PATH=/change-me/ghost-site/questdb_data
MAPS_PATH=/change-me/ghost-site/maps
OSRM_DATA_PATH=/change-me/ghost-site/osrm_data
