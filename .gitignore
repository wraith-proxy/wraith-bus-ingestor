# Live data volumes -- 29GB, owned and written by this repo's containers,
# physically migrated in from ghost-site/ on 2026-09-14. questdb_data/ is
# written by the QuestDB container as uid 10001, not by you.
questdb_data/
maps/
*.log

# Housekeeping
tree.txt
.env
.DS_Store
.aider*

# Python bytecode
__pycache__/
*.pyc

# Multi-GB OSM extract + generated routing graph -- keep the build script.
osrm_data/*
!osrm_data/build.sh

# dbt's own venv, data and build artifacts -- see dbt/.gitignore, which is
# more precise than a blanket pattern here would be.

# Packaging / tooling
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
docs/coverage.svg
docs/api.md
# docs/dbt/ is NOT ignored: it's generated locally against real live data
# (the CI runner has none) and committed deliberately -- see docs-dbt in
# pyproject.toml and pages.yml, which skips regenerating it if present.
requirements.txt
site/
dist/
.venv/
