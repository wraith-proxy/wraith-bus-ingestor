<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MapLibre's own manifest declares both location permissions for its
         optional LocationComponent ("show my position on the map"), which
         this app never enables: it only ever draws live bus positions,
         never the device's own. Stripped rather than carried silently, since
         an app requesting location it doesn't use is exactly the kind of
         thing an F-Droid reviewer would rightly flag. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <!-- Runtime-requested on first launch (MainActivity): required on
         API 33+, and minSdk here is 36, so it is always required. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- NtfyForegroundService holds a long-lived WebSocket, not a one-shot
         transfer: dataSync is the closest official FGS type to "keep a
         live connection open," and Android 14+ refuses to start a
         foreground service with no declared type at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".WraithBusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.WraithBus"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WraithBus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ntfy.NtfyForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
