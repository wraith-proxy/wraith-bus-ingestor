<?xml version="1.0" encoding="utf-8"?>
<!-- A real coach silhouette: rounded roofline, a three-pane window band,
     wheel arches, a small door-handle and indicator-light accent. Replaces
     the first cut's bare rectangle-plus-two-dots, which read as a crude
     placeholder rather than a bus. Kept inside the adaptive-icon safe zone
     (the centered ~66dp circle of this 108dp viewport). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground shadow -->
    <path
        android:pathData="M32,79 A22,3.4 0 1,0 76,79 A22,3.4 0 1,0 32,79 Z"
        android:fillColor="#071534" />

    <!-- Bus body -->
    <path
        android:pathData="M25,66 L25,46 A6,6 0 0,1 31,40 C40,36 60,34 76,36
                           C82,37 85,42 85,50 C85,56 84,62 80,66 L77,66
                           A7,7 0 0,0 63,66 L45,66 A7,7 0 0,0 31,66 L25,66 Z"
        android:fillColor="#FF5A1F" />

    <!-- Roof-mounted indicator light -->
    <path
        android:pathData="M72,39.5 H80 V42.9 H72 Z"
        android:fillColor="#1F7A4D" />

    <!-- Window band -->
    <path
        android:pathData="M33,44 H78 A3,3 0 0,1 81,47 V55 A3,3 0 0,1 78,58
                           H33 A3,3 0 0,1 30,55 V47 A3,3 0 0,1 33,44 Z"
        android:fillColor="#F3EFE6" />

    <!-- Window mullions -->
    <path android:pathData="M40.8,44 H43.4 V58 H40.8 Z" android:fillColor="#071534" />
    <path android:pathData="M53.4,44 H56 V58 H53.4 Z" android:fillColor="#071534" />
    <path android:pathData="M66,44 H68.6 V58 H66 Z" android:fillColor="#071534" />

    <!-- Body accent strip below the windows -->
    <path android:pathData="M25.5,60.5 H84 V62.1 H25.5 Z" android:fillColor="#7C8494" />

    <!-- Tail light -->
    <path
        android:pathData="M80.5,58.5 A2,2 0 1,0 84.5,58.5 A2,2 0 1,0 80.5,58.5 Z"
        android:fillColor="#F3EFE6" />

    <!-- Door handle -->
    <path android:pathData="M25.5,48 H27.5 V53 H25.5 Z" android:fillColor="#071534" />

    <!-- Rear step -->
    <path
        android:pathData="M78,63 C80,63.5 81.5,64.5 80.5,66 L77,66 L77,63.5 Z"
        android:fillColor="#071534" />

    <!-- Wheel arches -->
    <path
        android:pathData="M30,70 A8,8 0 1,0 46,70 A8,8 0 1,0 30,70 Z"
        android:fillColor="#071534" />
    <path
        android:pathData="M62,70 A8,8 0 1,0 78,70 A8,8 0 1,0 62,70 Z"
        android:fillColor="#071534" />
    <path
        android:pathData="M35,70 A3,3 0 1,0 41,70 A3,3 0 1,0 35,70 Z"
        android:fillColor="#7C8494" />
    <path
        android:pathData="M67,70 A3,3 0 1,0 73,70 A3,3 0 1,0 67,70 Z"
        android:fillColor="#7C8494" />
</vector>
