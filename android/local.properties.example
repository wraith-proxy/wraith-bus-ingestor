# Copy to local.properties (untracked, same convention as this repo's own
# .env / .env.example). Never commit the real file -- ntfyTopic is the same
# credential documented in docs/operations.md: whoever holds it can read
# every alert this app raises.

# Set by Android Studio normally; set it by hand here since this project was
# built without Studio ever touching it.
sdk.dir=/path/to/android-sdk

# https://www.thomaspeoples.com/api/ in production. Point this at a local
# backend (e.g. http://10.0.2.2:5000/ from an emulator) for development --
# 10.0.2.2 is the emulator's alias for the host machine's localhost.
apiBaseUrl=https://www.thomaspeoples.com/api/

# The same NTFY_TOPIC value from wraith-bus-ingestor's own .env -- this app
# subscribes to the identical topic Grafana's alerts publish to, over
# wss://www.thomaspeoples.com/ntfy/<topic>/ws. Baked into BuildConfig at
# build time, never hardcoded into a committed .kt file.
ntfyTopic=change-me
