[Unit]
Description=Run wraith-bus-ingestor GTFS refresh weekly, Monday 01:00

[Timer]
# Weekly is enough: the BODS feed's calendar.txt is forward-dated (to 2027-06-20
# at time of writing), so a week-old copy still describes every service that is
# running, and the route patterns change slowly.
# Monday 01:00 because the 02:00 precleanup and 03:00 build are the other tenants
# of the night. The runtime is NOT yet measured (59M stop_times rows plus the
# pattern build); the service's Before= makes precleanup and build wait if it
# overruns, and the first run's log gives the real figure to put here.
OnCalendar=Mon *-*-* 01:00:00
# No Persistent=: a catch-up run at an arbitrary boot time could land in the
# 02:00-03:00 window; a missed week is simply skipped until next Monday.
Unit=wraith-gtfs-refresh.service

[Install]
WantedBy=timers.target
